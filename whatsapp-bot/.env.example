# Shared secret — the web app sends this as the x-bot-secret header.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOT_SECRET=

# Who may call this service. Comma-separated, or * while testing.
ALLOWED_ORIGINS=https://relieforder.vercel.app,http://localhost:5173

PORT=8080

# Shop details used in message text
SHOP_NAME=Relief Medical
SHOP_PHONE=+91 9373624688

# Initial seed only — edit these from the admin panel afterwards.
ADMIN_NUMBERS=
CUSTOMER_STATUSES=placed,accepted,dispatched,delivered
SENDING_ENABLED=true

# Rate limiting (ban avoidance). Raise the gaps if you send a lot.
MIN_GAP_MS=8000
MAX_GAP_MS=20000
MAX_PER_HOUR=40

# Where the WhatsApp session and settings are stored. MUST be a persistent
# volume on your host, or you will re-scan the QR after every restart.
SESSION_PATH=./.wwebjs_auth
SETTINGS_PATH=./.bot-settings.json
